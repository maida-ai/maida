{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maida-ai/maida/schemas/statistical-gate-report.schema.json",
  "title": "Maida tier-aware gate report",
  "type": "object",
  "required": ["report_version", "verdict", "passed", "metadata", "trials", "aggregate_results"],
  "properties": {
    "report_version": { "const": "2.0.1" },
    "report_kind": { "enum": ["drift"] },
    "trials_requested": { "type": "integer", "minimum": 1 },
    "verdict": { "enum": ["pass", "fail", "inconclusive"] },
    "passed": { "type": ["boolean", "null"] },
    "baseline_acceptance": { "type": ["object", "null"] },
    "metadata": {
      "type": "object",
      "required": ["trials_used", "trials_budgeted", "stopping_rule", "abort_reason", "environment_fingerprint"],
      "properties": {
        "trials_used": { "type": "integer", "minimum": 1 },
        "trials_budgeted": { "type": "integer", "minimum": 1 },
        "stopping_rule": { "enum": ["fixed_n", "fixed_n_fail_fast"] },
        "abort_reason": { "type": ["string", "null"] },
        "environment_fingerprint": { "type": "object" }
      },
      "additionalProperties": true
    },
    "trials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["trial", "trace_id", "run_name", "process_exit_code", "passed", "checks", "metric_values", "invariant_outcomes", "structural_signature", "baseline_diff"],
        "properties": {
          "trial": { "type": "integer", "minimum": 1 },
          "trace_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
          "run_name": { "type": ["string", "null"] },
          "process_exit_code": { "type": ["integer", "null"] },
          "run_status": { "type": ["string", "null"], "enum": ["ok", "error", "running", null] },
          "passed": { "type": "boolean" },
          "checks": { "type": "array", "items": { "type": "object" } },
          "metric_values": { "type": "object", "additionalProperties": { "type": "number" } },
          "invariant_outcomes": { "type": "object", "additionalProperties": { "type": "boolean" } },
          "structural_signature": { "type": "object" },
          "baseline_diff": { "type": ["object", "null"] }
        },
        "additionalProperties": true
      }
    },
    "aggregate_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_name", "kind", "direction", "mode", "verdict", "decision_rule", "stopping_rule", "trials_used", "trials_budgeted", "trial_outcomes", "evidence"],
        "properties": {
          "check_name": { "type": "string" },
          "kind": { "enum": ["invariant", "measured", "distributional", "statistical"] },
          "direction": { "type": ["string", "null"], "enum": ["upper", "lower", "both", null] },
          "mode": { "enum": ["gating", "report_only"] },
          "verdict": { "type": ["string", "null"], "enum": ["pass", "fail", "inconclusive", null] },
          "decision_rule": { "enum": ["invariant", "tolerance", "wilson_one_sided", "report_only"] },
          "stopping_rule": { "enum": ["fixed_n", "fixed_n_fail_fast"] },
          "trials_used": { "type": "integer", "minimum": 1 },
          "trials_budgeted": { "type": "integer", "minimum": 1 },
          "trial_outcomes": { "type": "array", "items": { "type": "boolean" } },
          "evidence": { "type": "object" }
        },
        "additionalProperties": true
      }
    },
    "plan_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["trial", "checked_before_execution", "valid", "artifact", "issues", "graph_changes"],
        "properties": {
          "trial": { "type": ["integer", "null"], "minimum": 1 },
          "checked_before_execution": { "const": true },
          "valid": { "type": "boolean" },
          "artifact": {
            "anyOf": [
              { "$ref": "plan-artifact.schema.json" },
              { "type": "null" }
            ]
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["code", "message"],
              "properties": {
                "code": { "type": "string", "minLength": 1 },
                "message": { "type": "string", "minLength": 1 },
                "location": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          },
          "graph_changes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "location", "before", "after", "resolvable"],
              "properties": {
                "kind": {
                  "enum": [
                    "MODULE_DIGEST_CHANGED",
                    "BUDGET_CHANGED",
                    "CAPABILITY_CHANGED",
                    "EFFECT_CHANGED",
                    "CONNECTOR_CHANGED",
                    "POLICY_CHANGED",
                    "SCHEMA_CHANGED",
                    "INSERTION",
                    "DELETION",
                    "REORDER",
                    "TOPOLOGY_CHANGED",
                    "CONTROL_FLOW_CHANGED"
                  ]
                },
                "location": { "type": "string", "minLength": 1 },
                "before": {},
                "after": {},
                "resolvable": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "valid": { "const": true } },
              "required": ["valid"]
            },
            "then": {
              "properties": {
                "artifact": { "$ref": "plan-artifact.schema.json" },
                "issues": { "maxItems": 0 }
              }
            }
          },
          {
            "if": {
              "properties": { "valid": { "const": false } },
              "required": ["valid"]
            },
            "then": {
              "properties": { "issues": { "minItems": 1 } }
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
