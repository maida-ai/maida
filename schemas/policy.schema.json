{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maida-ai/maida/schemas/policy.schema.json",
  "title": "Maida policy v2",
  "type": "object",
  "required": ["version", "metrics"],
  "properties": {
    "version": {
      "description": "Hand-authored major[.minor] policy version; patch is invalid.",
      "enum": [2, "2", "2.0", 2.1, "2.1"]
    },
    "trials": { "type": "integer", "minimum": 1, "default": 3 },
    "fail_fast": { "type": "boolean", "default": true },
    "metrics": {
      "type": "object",
      "properties": {
        "plan_depth": { "$ref": "#/$defs/planNumericMetric" },
        "plan_fanout": { "$ref": "#/$defs/planNumericMetric" },
        "plan_budget_cost_usd": { "$ref": "#/$defs/planNumericMetric" },
        "plan_budget_model_tokens": { "$ref": "#/$defs/planNumericMetric" },
        "plan_budget_tool_calls": { "$ref": "#/$defs/planNumericMetric" },
        "plan_budget_wall_time_ms": { "$ref": "#/$defs/planNumericMetric" },
        "plan_effectful_modules": { "$ref": "#/$defs/planSetInvariant" },
        "plan_grants": { "$ref": "#/$defs/planGrantInvariant" }
      },
      "propertyNames": {
        "enum": [
          "stop_condition_reached",
          "forbidden_tools",
          "required_tools",
          "no_loops",
          "no_guardrails",
          "step_count",
          "tool_call_count",
          "cost_tokens",
          "latency_ms",
          "task_pass_rate",
          "plan_depth",
          "plan_fanout",
          "plan_budget_cost_usd",
          "plan_budget_model_tokens",
          "plan_budget_tool_calls",
          "plan_budget_wall_time_ms",
          "plan_effectful_modules",
          "plan_grants"
        ]
      },
      "additionalProperties": { "$ref": "#/$defs/metric" }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "version": { "enum": [2, "2", "2.0"] } },
        "required": ["version"]
      },
      "then": {
        "properties": {
          "metrics": {
            "propertyNames": {
              "not": {
                "enum": [
                  "plan_depth",
                  "plan_fanout",
                  "plan_budget_cost_usd",
                  "plan_budget_model_tokens",
                  "plan_budget_tool_calls",
                  "plan_budget_wall_time_ms",
                  "plan_effectful_modules",
                  "plan_grants"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "planNumericMetric": {
      "allOf": [
        { "$ref": "#/$defs/metric" },
        {
          "type": "object",
          "properties": {
            "kind": { "enum": ["measured", "distributional"] }
          }
        }
      ]
    },
    "planSetInvariant": {
      "allOf": [
        { "$ref": "#/$defs/metric" },
        {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "const": "invariant" },
            "none_of": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "all_of": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "allowed": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "anyOf": [
            { "required": ["allowed"] },
            {
              "required": ["none_of"],
              "properties": { "none_of": { "minItems": 1 } }
            },
            {
              "required": ["all_of"],
              "properties": { "all_of": { "minItems": 1 } }
            }
          ],
          "additionalProperties": false
        }
      ]
    },
    "planGrantInvariant": {
      "allOf": [
        { "$ref": "#/$defs/metric" },
        {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "const": "invariant" },
            "none_of": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "all_of": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "allowed": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "approval_required_for": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "anyOf": [
            { "required": ["allowed"] },
            {
              "required": ["none_of"],
              "properties": { "none_of": { "minItems": 1 } }
            },
            {
              "required": ["all_of"],
              "properties": { "all_of": { "minItems": 1 } }
            },
            {
              "required": ["approval_required_for"],
              "properties": { "approval_required_for": { "minItems": 1 } }
            }
          ],
          "additionalProperties": false
        }
      ]
    },
    "common": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["invariant", "measured", "distributional", "statistical"]
        }
      }
    },
    "metric": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "const": "invariant" },
            "require": { "type": "boolean" },
            "none_of": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "all_of": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "allowed": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "approval_required_for": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "direction"],
          "properties": {
            "kind": { "const": "measured" },
            "direction": { "enum": ["upper", "lower", "both"] },
            "aggregate": { "enum": ["median", "max", "p90"] },
            "tolerance": {
              "type": "object",
              "properties": {
                "relative": { "type": "number", "minimum": 0 },
                "absolute": { "type": "number", "minimum": 0 }
              },
              "minProperties": 1,
              "additionalProperties": false
            },
            "limit": {}
          },
          "anyOf": [
            { "required": ["tolerance"] },
            { "required": ["limit"] }
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "direction"],
          "properties": {
            "kind": { "const": "distributional" },
            "direction": { "enum": ["upper", "lower"] },
            "coverage": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            "confidence": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            "mode": { "enum": ["gating", "report_only"] }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "direction", "threshold"],
          "properties": {
            "kind": { "const": "statistical" },
            "direction": { "enum": ["upper", "lower", "both"] },
            "threshold": {},
            "confidence": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            "mode": { "enum": ["gating", "report_only"] },
            "success_predicate": {
              "const": "all_invariants_passed"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
